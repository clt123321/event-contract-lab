# Language/tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage/
dist/
build/

# Secrets and credentials must never enter Git.
*.pem
*.key
*.p12
credentials.json
secrets/

# Local IDE state.
.idea/
.vscode/
