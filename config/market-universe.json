    },
    "predict_fun": {
      "role": "target_venue",
      "environment": "testnet",
      "access_mode": "read_only",
      "assets": ["BTC", "ETH"],
      "cadence": "short_cycle",
      "approved_market_ids": [],
      "external_blockers": [
        "Official Discord ticket response",
        "Testnet collector permission/key",
        "Sanitized message fixtures"
      ]
    },
    "polymarket": {
      "role": "target_venue",
      "access_mode": "public_read_only",
      "selection_policy": "manual_freeze_after_public_discovery",
      "approved_market_count": { "minimum": 3, "maximum": 5 },
      "approved_markets": [],
      "readiness": "blocked_until_manual_market_freeze"
    }
  },
  "deferred_sources": ["chainlink", "deribit"]
}
