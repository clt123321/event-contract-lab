{
  "schema_version": 1,
  "project": "event-contract-lab",
  "execution": {
    "mode": "disabled",
    "live_enabled": false,
    "reason": "Live execution is blocked until the independent G3 approval gate."
  },
  "retention": {
    "wal_hours": 72,
    "wal_sync_every_rows": 1000,
    "wal_sync_interval_ms": 1000,
