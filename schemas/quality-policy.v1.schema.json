{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-contract-lab.local/schemas/quality-policy.v1.schema.json",
  "title": "QualityPolicy v1",
  "type": "object",
  "required": [
    "schema_version", "policy_version", "timestamp_future_tolerance_ms",
    "stale_event_threshold_ms", "reject_duplicate_raw_event",
    "reject_sequence_regression", "reject_crossed_book",
    "event_contract_price_min", "event_contract_price_max"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "timestamp_future_tolerance_ms": { "type": "number", "minimum": 0 },
    "stale_event_threshold_ms": { "type": "number", "exclusiveMinimum": 0 },
    "reject_duplicate_raw_event": { "type": "boolean" },
    "reject_sequence_regression": { "type": "boolean" },
    "reject_crossed_book": { "type": "boolean" },
    "event_contract_price_min": { "type": "number" },
    "event_contract_price_max": { "type": "number" }
  },
  "additionalProperties": false
}
