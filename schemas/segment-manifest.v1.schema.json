{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-contract-lab.local/schemas/segment-manifest.v1.schema.json",
  "title": "SegmentManifest v1",
  "type": "object",
  "required": [
    "schema_version", "segment_file", "sha256", "row_count", "byte_count",
    "min_recv_wall_ts_ms", "max_recv_wall_ts_ms", "sources", "streams", "sealed_at_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "segment_file": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "row_count": { "type": "integer", "minimum": 1 },
    "byte_count": { "type": "integer", "minimum": 1 },
    "min_recv_wall_ts_ms": { "type": "number" },
    "max_recv_wall_ts_ms": { "type": "number" },
    "min_source_event_ts_ms": { "type": ["number", "null"] },
    "max_source_event_ts_ms": { "type": ["number", "null"] },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "streams": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "schema_versions": { "type": "array", "items": { "type": "integer" } },
    "git_commit": { "type": ["string", "null"] },
    "sealed_at_ms": { "type": "integer", "minimum": 1 },
    "recovered_after_restart": { "type": "boolean" }
  },
  "additionalProperties": false
}
