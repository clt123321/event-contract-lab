{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-contract-lab.local/schemas/dataset-manifest.v1.schema.json",
  "title": "DatasetManifest v1",
  "type": "object",
  "required": [
    "schema_version", "dataset_id", "created_at_ms", "segment_manifests",
    "feature_version", "quality_mask_version", "code_commit", "random_seed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "created_at_ms": { "type": "integer", "minimum": 1 },
    "segment_manifests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "feature_version": { "type": "string", "minLength": 1 },
    "quality_mask_version": { "type": "string", "minLength": 1 },
    "code_commit": { "type": "string", "minLength": 1 },
    "random_seed": { "type": "integer", "minimum": 0 },
    "parameters": { "type": "object" }
  },
  "additionalProperties": false
}
