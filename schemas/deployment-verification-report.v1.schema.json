{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-contract-lab.local/schemas/deployment-verification-report.v1.schema.json",
  "title": "DeploymentVerificationReport v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "status",
    "started_at",
    "finished_at",
    "output_directory",
    "verification_profile",
    "configuration",
    "safety_scope",
    "checks",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["local", "host-smoke"] },
    "status": { "enum": ["passed", "warning", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "output_directory": { "type": "string", "minLength": 1 },
    "verification_profile": {
      "type": "object",
      "required": ["path", "schema_version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["market_universe"],
      "properties": {
        "market_universe": {
          "type": "object",
          "required": ["path", "schema_version", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "schema_version": { "const": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": { "type": ["object", "null"] },
    "git": { "type": ["object", "null"] },
    "parameters": { "type": "object" },
    "safety_scope": { "type": "object" },
    "fatal_error": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "severity", "actual", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "severity": { "enum": ["error", "warning"] },
          "actual": {},
          "expected": {}
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "args", "exit_code", "duration_ms", "stdout_log", "stderr_log"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "exit_code": { "type": ["integer", "null"] },
          "duration_ms": { "type": "number", "minimum": 0 },
          "stdout_log": { "type": "string", "minLength": 1 },
          "stderr_log": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
