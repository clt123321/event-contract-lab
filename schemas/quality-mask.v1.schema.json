{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-contract-lab.local/schemas/quality-mask.v1.schema.json",
  "title": "QualityMask v1",
  "type": "object",
  "required": ["schema_version", "mask_version", "exclude_unlisted_flags", "allowed_flags"],
  "properties": {
    "schema_version": { "const": 1 },
    "mask_version": { "type": "string", "minLength": 1 },
    "exclude_unlisted_flags": { "type": "boolean" },
    "allowed_flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
